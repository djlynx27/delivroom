# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=      # clé publique Web Push VAPID (frontend)

# Variables backend Edge Functions (à définir via `supabase secrets set`)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:alerts@hustlego.local

# service_role -- JAMAIS préfixé VITE_ (Vite l'inlinerait dans le bundle
# client). Utilisé uniquement par des scripts locaux one-off (ex.
# `npm run seed:synthetic`), jamais par l'app ni les Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# Même valeur que `supabase secrets set INGEST_LYFT_API_KEY=...` (secret
# Edge Function dédié, PAS l'anon/service_role key) -- utilisé uniquement par
# scripts/scrape_lyft_metrics.py en local, jamais bundlé (pas de préfixe VITE_).
INGEST_LYFT_API_KEY=

# Jeton partagé pour scripts/server.py (bridge HTTP local déclenché par
# MacroDroid) -- génère une valeur aléatoire distincte de INGEST_LYFT_API_KEY.
# scripts/server.py écoute sur 0.0.0.0, donc n'importe quel appareil sur le
# même wifi/tailnet peut l'atteindre : ce jeton est ce qui empêche un
# déclenchement non autorisé.
LYFT_BRIDGE_API_KEY=

# ── Cartographie / Trafic ─────────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=          # maps.mapbox.com → Tokens
VITE_TOMTOM_KEY=            # developer.tomtom.com → My Apps

# ── Données temps réel ────────────────────────────────────────────────────────
# STM (Société de transport de Montréal) — GRATUIT
# Inscription : portail.developpeurs.stm.info
# Permet : GTFS-RT serviceAlerts, vehiclePositions, tripUpdates
VITE_STM_KEY=

# AviationStack — optionnel, 100 req/mois GRATUIT
# Inscription : aviationstack.com (plan Free)
# Utilisé pour enrichir les vagues d'arrivées YUL avec des données live
# Fallback : schedule statique intégré si absent
VITE_AVIATIONSTACK_KEY=

# ── Événements ────────────────────────────────────────────────────────────────
# Ticketmaster Discovery API — GRATUIT
# Inscription : developer.ticketmaster.com
VITE_TICKETMASTER_KEY=

# ── Lieux (optionnel) ─────────────────────────────────────────────────────────
VITE_FOURSQUARE_API_KEY=
